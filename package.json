{
  "name": "outlook-calendar-scroll",
  "version": "1.8.1",
  "description": "A userscript to enhance scrolling in PWA Outlook calendar",
  "devDependencies": {
    "@types/node": "^25.9.4",
    "npm-run-all2": "^9.0.2",
    "serve": "^14.2.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:watch": "vite build --watch",
    "build": "run-p typecheck build-only",
    "build-only": "vite build",
    "serve": "serve dist",
    "dev": "run-p build:watch serve"
  }
}
