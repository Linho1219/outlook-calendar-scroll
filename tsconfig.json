{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2023", "DOM"],
    "moduleResolution": "Bundler",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "useDefineForClassFields": true,

    "skipLibCheck": true,
    "isolatedModules": true,

    "allowJs": false,
    "checkJs": false,

    "sourceMap": true
  },

  "include": ["src/**/*.ts","userscript.meta.ts"]
}